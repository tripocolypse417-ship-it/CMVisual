{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.waveradar.invalid/evidence/observation-v1.schema.json",
  "title": "WaveRadar Observation Envelope v1",
  "description": "Portable, provenance-preserving envelope for one observation. This schema does not assert that a sensor observation is physically accurate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "incident_id",
    "source",
    "event_time",
    "received_at",
    "evidence_class",
    "payload",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "observation_id": {
      "type": "string",
      "format": "uuid"
    },
    "incident_id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "source_id"
      ],
      "properties": {
        "source_type": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "device_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "sensor_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "software_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "event_time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp"
      ],
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "clock_basis": {
          "type": [
            "string",
            "null"
          ]
        },
        "uncertainty_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "spatial_reference": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "frame"
      ],
      "properties": {
        "frame": {
          "type": "string",
          "minLength": 1
        },
        "coordinates": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 4
        },
        "units": {
          "type": [
            "string",
            "null"
          ]
        },
        "uncertainty_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "sensor_state": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "capability": {
          "type": [
            "string",
            "null"
          ]
        },
        "permission_state": {
          "type": [
            "string",
            "null"
          ]
        },
        "availability": {
          "enum": [
            "AVAILABLE",
            "LIMITED",
            "UNAVAILABLE",
            "UNKNOWN",
            null
          ]
        },
        "quality_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidence_class": {
      "enum": [
        "MEASURED",
        "DERIVED",
        "INFERRED",
        "PREDICTED",
        "SIMULATED",
        "UNKNOWN",
        "UNAVAILABLE"
      ]
    },
    "payload": {
      "type": "object",
      "description": "Structured observation or a reference to a separately stored immutable evidence object."
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_method"
      ],
      "properties": {
        "capture_method": {
          "type": "string",
          "minLength": 1
        },
        "content_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(sha256:)?[a-fA-F0-9]{64}$"
        },
        "digest_algorithm": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent_observation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "transformation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "retention": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "accepted_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "immutable_after_acceptance": {
          "type": "boolean"
        },
        "correction_of": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      }
    }
  }
}
