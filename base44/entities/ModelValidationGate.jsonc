{
  "name": "ModelValidationGate",
  "type": "object",
  "properties": {
    "model_id": {
      "type": "string"
    },
    "gate_version": {
      "type": "string"
    },
    "required_validation_status": {
      "type": "string",
      "enum": [
        "INTERNAL",
        "EXTERNAL",
        "REPLICATED"
      ]
    },
    "required_metrics_json": {
      "type": "string"
    },
    "uncertainty_calibration_required": {
      "type": "boolean"
    },
    "production_allowed": {
      "type": "boolean"
    },
    "reason": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "model_id",
    "gate_version",
    "required_validation_status",
    "production_allowed"
  ]
}