{
  "name": "Snapshot Drive Archive",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "snapshot_drive_archive",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "export_to_drive": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "exportSnapshotToDrive",
            "args": {
              "snapshot_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Export snapshot to Drive",
            "description": "Upload JSON archive to Google Drive"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Snapshot"
    }
  },
  "description": "Automatically exports each new scan snapshot to Google Drive as a permanent archive."
}