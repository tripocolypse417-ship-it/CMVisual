{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_investor_digest",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_digest": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "weeklyInvestorDigest"
          },
          "then": "end",
          "x-base44": {
            "title": "Send weekly digest",
            "description": "Gmail summary of new investor leads"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * 1",
      "one_time_date": null,
      "timezone": "America/Chicago",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Emails a weekly summary of new investor leads via Gmail every Monday at 9am (America/Chicago).",
  "name": "Weekly Investor Digest"
}