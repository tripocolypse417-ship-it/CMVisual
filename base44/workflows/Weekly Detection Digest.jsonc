{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * 1",
      "one_time_date": null,
      "timezone": "America/Chicago",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_detection_digest",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_digest": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "weeklyDetectionDigest"
          },
          "then": "end",
          "x-base44": {
            "title": "Send weekly detection digest",
            "description": "PDF of last 7 days emailed to the team"
          }
        }
      }
    ]
  },
  "description": "Emails a weekly PDF summary of detection logs to the team via Gmail every Monday morning",
  "name": "Weekly Detection Digest"
}