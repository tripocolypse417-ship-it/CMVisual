{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WaveRadar dataset acquisition manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_schema",
    "hash_algorithm",
    "dataset_id",
    "source_url",
    "dataset_version",
    "license_snapshot",
    "retrieved_at",
    "generated_at",
    "file_count",
    "total_size_bytes",
    "files",
    "manifest_sha256"
  ],
  "properties": {
    "manifest_schema": {
      "const": "waveradar-dataset-acquisition-manifest-v1"
    },
    "hash_algorithm": {
      "const": "sha256"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]+$"
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1
    },
    "license_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "commercial_use",
        "reviewed_on"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "commercial_use": {
          "type": "string"
        },
        "reviewed_on": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "file_count": {
      "type": "integer",
      "minimum": 1
    },
    "total_size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
